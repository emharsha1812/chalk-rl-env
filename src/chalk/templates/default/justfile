_default:
  @just --list

# Recipes shipped by add-on templates; `import?` tolerates the file being absent.
import? 'toolchains.just'
import? 'internal.just'

# Static analysis
lint:
  uv run --frozen --extra dev ruff format --check
  uv run --frozen --extra dev ruff check
  uv run --frozen --extra dev scripts/check_supply_chain_config.py

# Apply automatic fixes for linting
fix:
  uv run --frozen --extra dev ruff check --fix

# Formatting
fmt:
  uv run --frozen --extra dev ruff format

# Run tests for the environment
test:
  uv run --frozen --extra test pytest

# Lock all venv dependencies
lock-venvs:
  for dir in venvs/*/; do (cd "$dir" && uv lock); done

# Refresh the local source and templates with the Chalk command installed from
# your checkout. Run this command outside the environment's own virtualenv:
#   chalk update /path/to/this/environment

# Create a new task (task_id can contain hyphens, e.g., "my-cool-task")
create-task task_id dir_name=(replace(task_id, "-", "_")):
  cp -r src/environment/tasks/_template "src/environment/tasks/{% raw %}{{ dir_name }}{% endraw %}"
  perl -i -pe 's/id = ""/id = "{% raw %}{{ task_id }}{% endraw %}"/' "src/environment/tasks/{% raw %}{{ dir_name }}{% endraw %}/__init__.py"

# Create a new task suite: tasks generated from axes of variation (suite_id can contain hyphens)
create-task-suite suite_id dir_name=(replace(suite_id, "-", "_")):
  #!/usr/bin/env bash
  set -euo pipefail
  dest="src/environment/tasks/{% raw %}{{ dir_name }}{% endraw %}"
  cp -r src/environment/tasks/_template_suite "$dest"
  find "$dest" -name __pycache__ -type d -exec rm -rf {} +
  grep -rl _template_suite "$dest" | xargs perl -i -pe 's/_template_suite/{% raw %}{{ dir_name }}{% endraw %}/g'
  perl -i -pe 's/^SUITE_ID = ".*"/SUITE_ID = "{% raw %}{{ suite_id }}{% endraw %}"/' "$dest/task_configs/create_task_configs.py"
  just gen-configs {% raw %}{{ dir_name }}{% endraw %}

# Regenerate a suite's committed task and calibration config JSON
gen-configs suite dir_name=(replace(suite, "-", "_")):
  uv run --frozen python -m environment.suite {% raw %}{{ dir_name }}{% endraw %}
